# Port Express Server lắng nghe
PORT=5000

# Khóa bí mật ký JWT Token (hãy đổi chuỗi ngẫu nhiên khi đưa lên production)
JWT_SECRET=dashboard_super_secret_jwt_key_2026_antigravity

# Cấu hình tự động sao lưu dữ liệu lên Cloud
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24

# Cấu hình sao lưu lên Telegram Bot (Nhận file backup miễn phí trực tiếp trên Telegram)
# 1. Chat với @BotFather để tạo bot và lấy Token
TELEGRAM_BOT_TOKEN=
# 2. Chat với @userinfobot để lấy ID của bạn hoặc ID kênh riêng tư (-100xxxxxxx)
TELEGRAM_CHAT_ID=

# Cấu hình Webhook tùy chọn (Discord / Make / Zapier)
BACKUP_WEBHOOK_URL=
